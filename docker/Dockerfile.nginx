# Nginx 镜像：托管预编译静态资源 + 反向代理配置
# 子应用由 deploy.sh → prebuild-subapps.sh 在本地编译后打入 tar，服务器不再跑 Vite（避免 OOM）

FROM nginx:1.27-alpine AS runner

COPY docker/nginx.conf /etc/nginx/nginx.conf

# 预编译产物（deploy 打包前须在本地执行 docker/prebuild-subapps.sh）
COPY qiankun-subapps/app-web/dist /usr/share/nginx/micro/web
COPY qiankun-subapps/app-admin/dist /usr/share/nginx/micro/admin
COPY convenience-client/dist/build/h5 /usr/share/nginx/convenience

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
