/** 自定义 TabBar：钴蓝编辑感，与 AppTabBar 视觉对齐 */
.cv-tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  pointer-events: auto;
}

.cv-tabbar__safe {
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(248, 251, 255, 0.92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-top: 1rpx solid rgba(29, 78, 216, 0.1);
  box-shadow: 0 -8rpx 40rpx rgba(29, 78, 216, 0.1);
}

.cv-tabbar__bar {
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  height: 100rpx;
  padding: 0 8rpx;
}

.cv-tabbar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 8rpx 4rpx 10rpx;
}

.cv-tabbar__icon {
  width: 44rpx;
  height: 44rpx;
}

.cv-tabbar__text {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.2;
}

/** 中间发布凸起按钮 */
.cv-tabbar__item--publish {
  position: relative;
  justify-content: flex-end;
  padding-bottom: 6rpx;
}

.cv-tabbar__publish-circle {
  width: 112rpx;
  height: 112rpx;
  margin-top: -36rpx;
  border-radius: 50%;
  background: #1d4ed8;
  box-shadow: 0 12rpx 32rpx rgba(29, 78, 216, 0.38);
  display: flex;
  align-items: center;
  justify-content: center;
}

.cv-tabbar__publish-plus {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -6rpx;
}
