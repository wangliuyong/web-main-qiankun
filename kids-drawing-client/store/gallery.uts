/**
 * 作品集 Store：保存、删除作品
 */
import { state, setGallery } from '@/store/index.uts'
import type { GalleryWork, GalleryData } from '@/types/gallery.uts'
import { GALLERY_MAX_COUNT } from '@/types/gallery.uts'
import { saveGallery, generateId } from '@/utils/storage.uts'

/**
 * 添加作品到画廊
 * @returns 是否成功（超限返回 false）
 */
export function postAddWork(lessonId: string, lessonTitle: string, thumbnail: string): boolean {
  const gallery = state.gallery
  if (gallery.works.length >= GALLERY_MAX_COUNT) {
    return false
  }
  const work: GalleryWork = {
    id: generateId(),
    lessonId: lessonId,
    lessonTitle: lessonTitle,
    thumbnail: thumbnail,
    createdAt: Date.now()
  }
  gallery.works.unshift(work)
  setGallery(gallery)
  saveGallery(gallery)
  return true
}

/** 删除作品 */
export function postRemoveWork(workId: string): void {
  const gallery = state.gallery
  const filtered: GalleryWork[] = []
  for (let i = 0; i < gallery.works.length; i++) {
    if (gallery.works[i].id != workId) {
      filtered.push(gallery.works[i])
    }
  }
  gallery.works = filtered
  setGallery(gallery)
  saveGallery(gallery)
}

/** 从本地存储水合作品集 */
export function hydrateGallery(data: GalleryData): void {
  setGallery(data)
}

/** 获取作品数量 */
export function queryWorkCount(): number {
  return state.gallery.works.length
}
