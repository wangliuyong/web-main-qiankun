<template>
  <view class="page-root">
    <view class="safe-top" :style="{ height: statusBarHeight + 'px' }"></view>
    <!-- 顶部栏 -->
    <view class="studio-header">
      <view class="header-left" @click="goBack">
        <text class="back-text">←</text>
      </view>
      <text class="header-title">{{ pageTitle }}</text>
      <view class="header-right" @click="onComplete">
        <text class="complete-text">完成 ✓</text>
      </view>
    </view>

    <!-- 分步引导（课时模式） -->
    <StepGuide
      v-if="lesson != null"
      v-model:currentStep="currentStep"
      v-model:showGuide="showGuide"
      :totalSteps="totalSteps"
      :hintText="currentHint"
      :shapeType="currentShapeType"
      @next="onStepNext"
    />

    <!-- 工具栏 -->
    <DrawToolbar
      v-model:brushSize="brushSize"
      v-model:isEraser="isEraser"
      @undo="onUndo"
      @clear="onClear"
    />

    <!-- 色板 -->
    <ColorPalette v-model="brushColor" />

    <!-- 画布区域 -->
    <view class="canvas-area">
      <DrawCanvas
        ref="canvasRef"
        :brushColor="brushColor"
        :brushSize="brushSize"
        :isEraser="isEraser"
        @strokeChange="onStrokeChange"
      />
    </view>

    <!-- 底部操作 -->
    <view class="bottom-actions">
      <view class="action-btn save-btn" @click="onSave">
        <text class="action-text">💾 保存作品</text>
      </view>
    </view>

    <!-- 星星奖励弹窗 -->
    <StarReward
      v-model:visible="showReward"
      :starCount="earnedStars"
      :subtitle="rewardSubtitle"
      @close="onRewardClose"
    />

    <KidTabBar v-if="isFreeMode" :current="1" />
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from 'vue'
  import DrawCanvas from '@/components/DrawCanvas/DrawCanvas.uvue'
  import ColorPalette from '@/components/ColorPalette/ColorPalette.uvue'
  import DrawToolbar from '@/components/DrawToolbar/DrawToolbar.uvue'
  import StepGuide from '@/components/StepGuide/StepGuide.uvue'
  import StarReward from '@/components/StarReward/StarReward.uvue'
  import KidTabBar from '@/components/KidTabBar/KidTabBar.uvue'
  import { queryLessonById, calcRewardStars } from '@/utils/lesson-loader.uts'
  import { postLessonComplete } from '@/store/progress.uts'
  import { postAddWork } from '@/store/gallery.uts'
  import type { LessonItem } from '@/types/lesson.uts'

  const statusBarHeight = ref(0)
  const lessonId = ref('')
  const lesson = ref<LessonItem | null>(null)
  const isFreeMode = ref(true)

  const brushColor = ref('#2D3436')
  const brushSize = ref(6)
  const isEraser = ref(false)
  const strokeCount = ref(0)
  const currentStep = ref(0)
  const showGuide = ref(true)
  const completedSteps = ref(0)

  const showReward = ref(false)
  const earnedStars = ref(0)
  const rewardSubtitle = ref('')

  const canvasRef = ref<ComponentPublicInstance | null>(null)

  const pageTitle = computed((): string => {
    if (lesson.value != null) {
      return lesson.value!.title
    }
    return '自由画板'
  })

  const totalSteps = computed((): number => {
    if (lesson.value == null) {
      return 0
    }
    return lesson.value!.steps.length
  })

  const currentHint = computed((): string => {
    if (lesson.value == null) {
      return '自由创作吧！'
    }
    const steps = lesson.value!.steps
    if (currentStep.value < steps.length) {
      return steps[currentStep.value].hint
    }
    return '完成所有步骤啦！'
  })

  const currentShapeType = computed((): string => {
    if (lesson.value == null) {
      return 'free'
    }
    const steps = lesson.value!.steps
    if (currentStep.value < steps.length) {
      return steps[currentStep.value].shapeType
    }
    return 'free'
  })

  function onStrokeChange(count: number): void {
    strokeCount.value = count
  }

  function onStepNext(): void {
    completedSteps.value++
  }

  function onUndo(): void {
    const ref = canvasRef.value
    if (ref != null) {
      (ref as any).undo()
    }
  }

  function onClear(): void {
    uni.showModal({
      title: '清空画布',
      content: '确定要清空所有笔画吗？',
      success: (res) => {
        if (res.confirm) {
          const ref = canvasRef.value
          if (ref != null) {
            (ref as any).clear()
          }
          strokeCount.value = 0
        }
      }
    })
  }

  function onSave(): void {
    const ref = canvasRef.value
    if (ref == null) {
      return
    }
    const base64 = (ref as any).exportImage() as string
    if (base64 == '') {
      uni.showToast({ title: '画布未就绪', icon: 'none' })
      return
    }
    const title = lesson.value != null ? lesson.value!.title : '自由创作'
    const lid = lesson.value != null ? lesson.value!.id : 'free'
    const ok = postAddWork(lid, title, base64)
    if (ok) {
      uni.showToast({ title: '作品已保存！', icon: 'success' })
    } else {
      uni.showToast({ title: '作品已满，请删除旧作', icon: 'none' })
    }
  }

  function onComplete(): void {
    if (lesson.value == null) {
      // 自由模式：仅保存
      onSave()
      return
    }
    const l = lesson.value!
    const stars = calcRewardStars(l, strokeCount.value, completedSteps.value, l.steps.length)
    if (stars == 0) {
      uni.showToast({ title: '再画几笔吧！至少 ' + l.minStrokes.toString() + ' 笔', icon: 'none' })
      return
    }
    earnedStars.value = stars
    rewardSubtitle.value = '你完成了「' + l.title + '」'
    postLessonComplete(l, stars, strokeCount.value)
    showReward.value = true
    // 自动保存作品
    onSave()
  }

  function onRewardClose(): void {
    uni.navigateBack({})
  }

  function goBack(): void {
    if (isFreeMode.value) {
      uni.redirectTo({ url: '/pages/home/index' })
    } else {
      uni.navigateBack({})
    }
  }

  onLoad((options: OnLoadOptions) => {
    const info = uni.getWindowInfo()
    statusBarHeight.value = info.statusBarHeight
    const id = options['lessonId'] as string | null
    if (id != null && id != '') {
      lessonId.value = id
      lesson.value = queryLessonById(id)
      isFreeMode.value = false
    } else {
      isFreeMode.value = true
    }
  })
</script>

<style lang="scss">
  .studio-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background-color: #FFD166;
    border-bottom-width: 3px;
    border-bottom-color: #2D3436;
    border-bottom-style: solid;
  }

  .header-left, .header-right {
    min-width: 60px;
  }

  .back-text {
    font-size: 22px;
    color: #2D3436;
  }

  .header-title {
    font-size: 18px;
    font-weight: bold;
    color: #2D3436;
  }

  .complete-text {
    font-size: 16px;
    font-weight: bold;
    color: #FF6B6B;
    text-align: right;
  }

  .canvas-area {
    flex: 1;
    margin: 8px 12px;
    min-height: 300px;
  }

  .bottom-actions {
    padding: 8px 16px 4px 16px;
  }

  .action-btn {
    border-radius: 20px;
    padding: 12px;
    align-items: center;
    border-width: 2px;
    border-color: #2D3436;
    border-style: solid;
  }

  .save-btn {
    background-color: #4ECDC4;
  }

  .action-text {
    font-size: 16px;
    font-weight: bold;
    color: #2D3436;
  }
</style>
