<template>
  <view class="page-root">
    <view class="safe-top" :style="{ height: statusBarHeight + 'px' }"></view>

    <!-- 用户卡片 -->
    <view class="profile-card">
      <text class="avatar">{{ avatarEmoji }}</text>
      <view class="profile-info">
        <text class="nickname">{{ nickname }}</text>
        <text class="profile-sub">小画家成长中 🌱</text>
      </view>
    </view>

    <scroll-view class="profile-scroll" scroll-y="true">
      <!-- 统计数据 -->
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-num">{{ totalStars }}</text>
          <text class="stat-label">总星星</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{ streakDays }}</text>
          <text class="stat-label">连续天数</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{ completedCount }}</text>
          <text class="stat-label">完成课时</text>
        </view>
        <view class="stat-item">
          <text class="stat-num">{{ workCount }}</text>
          <text class="stat-label">作品数</text>
        </view>
      </view>

      <!-- 徽章墙 -->
      <text class="section-title">我的徽章 🏅</text>
      <view class="badge-grid">
        <view
          v-for="(badge, idx) in allBadges"
          :key="idx"
          class="badge-item"
          :class="isUnlocked(badge.id) ? 'badge-unlocked' : 'badge-locked'"
        >
          <text class="badge-icon">{{ isUnlocked(badge.id) ? '🏆' : '🔒' }}</text>
          <text class="badge-title">{{ badge.title }}</text>
          <text class="badge-desc">{{ badge.description }}</text>
        </view>
      </view>

      <!-- 学习记录 -->
      <text class="section-title">最近完成</text>
      <view v-if="recentRecords.length > 0">
        <view
          v-for="(record, idx) in recentRecords"
          :key="idx"
          class="record-item"
        >
          <text class="record-title">{{ getLessonTitle(record.lessonId) }}</text>
          <text class="record-stars">{{ getStarText(record.stars) }}</text>
        </view>
      </view>
      <view v-else class="no-record">
        <text class="no-record-text">还没有完成记录，快去画画吧！</text>
      </view>

      <!-- 修改昵称 -->
      <view class="nickname-edit" @click="onEditNickname">
        <text class="edit-text">✏️ 修改昵称</text>
      </view>
    </scroll-view>

    <KidTabBar :current="3" />
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from 'vue'
  import KidTabBar from '@/components/KidTabBar/KidTabBar.uvue'
  import { state, setProfile } from '@/store/index.uts'
  import { saveProfile } from '@/utils/storage.uts'
  import { queryBadges, queryLessonById } from '@/utils/lesson-loader.uts'
  import type { BadgeDef } from '@/types/lesson.uts'
  import type { LessonProgress } from '@/types/progress.uts'

  const statusBarHeight = ref(0)
  const allBadges = ref<BadgeDef[]>(queryBadges())

  const nickname = computed(() => state.profile.nickname)
  const avatarEmoji = computed(() => state.profile.avatarEmoji)
  const totalStars = computed(() => state.progress.totalStars)
  const streakDays = computed(() => state.progress.streakDays)
  const workCount = computed(() => state.gallery.works.length)

  const completedCount = computed(() => state.progress.lessonRecords.length)

  /** 最近 5 条完成记录 */
  const recentRecords = computed((): LessonProgress[] => {
    const records = state.progress.lessonRecords
    const sorted: LessonProgress[] = []
    for (let i = 0; i < records.length; i++) {
      sorted.push(records[i])
    }
    // 按完成时间倒序（简单冒泡）
    for (let i = 0; i < sorted.length - 1; i++) {
      for (let j = i + 1; j < sorted.length; j++) {
        if (sorted[j].completedAt > sorted[i].completedAt) {
          const temp = sorted[i]
          sorted[i] = sorted[j]
          sorted[j] = temp
        }
      }
    }
    const result: LessonProgress[] = []
    const limit = sorted.length < 5 ? sorted.length : 5
    for (let i = 0; i < limit; i++) {
      result.push(sorted[i])
    }
    return result
  })

  function isUnlocked(badgeId: string): boolean {
    return state.progress.unlockedBadges.indexOf(badgeId) >= 0
  }

  function getLessonTitle(lessonId: string): string {
    const lesson = queryLessonById(lessonId)
    if (lesson == null) {
      return lessonId
    }
    return lesson.title
  }

  function getStarText(stars: number): string {
    let text = ''
    for (let i = 0; i < stars; i++) {
      text += '⭐'
    }
    return text
  }

  function onEditNickname(): void {
    uni.showModal({
      title: '修改昵称',
      editable: true,
      placeholderText: '输入新昵称',
      success: (res) => {
        if (res.confirm && res.content != null && res.content != '') {
          const profile = state.profile
          profile.nickname = res.content!
          setProfile(profile)
          saveProfile(profile)
        }
      }
    })
  }

  onLoad(() => {
    const info = uni.getWindowInfo()
    statusBarHeight.value = info.statusBarHeight
  })
</script>

