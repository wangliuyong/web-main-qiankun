<template>
  <view class="page-root">
    <view class="safe-top" :style="{ height: statusBarHeight + 'px' }"></view>
    <view class="gallery-header">
      <text class="header-title">我的作品 🖼️</text>
      <text class="work-count">共 {{ workCount }} 幅</text>
    </view>

    <scroll-view v-if="works.length > 0" class="gallery-scroll" scroll-y="true">
      <view class="gallery-grid">
        <view
          v-for="(work, idx) in works"
          :key="idx"
          class="work-card"
          @click="onPreview(work)"
          @longpress="onDelete(work)"
        >
          <image class="work-thumb" :src="work.thumbnail" mode="aspectFill"></image>
          <text class="work-title">{{ work.lessonTitle }}</text>
          <text class="work-date">{{ formatDate(work.createdAt) }}</text>
        </view>
      </view>
    </scroll-view>

    <view v-else class="empty-wrap">
      <text class="empty-icon">🎨</text>
      <text class="empty-text">还没有作品哦</text>
      <text class="empty-hint">完成课时或自由创作后保存吧！</text>
      <view class="empty-btn" @click="goStudio">
        <text class="empty-btn-text">去画画 →</text>
      </view>
    </view>

    <!-- 预览弹窗 -->
    <view v-if="previewWork != null" class="preview-mask" @click="closePreview">
      <view class="preview-card" @click.stop="">
        <image class="preview-image" :src="previewWork!.thumbnail" mode="aspectFit"></image>
        <text class="preview-title">{{ previewWork!.lessonTitle }}</text>
        <view class="preview-close" @click="closePreview">
          <text class="preview-close-text">关闭</text>
        </view>
      </view>
    </view>

    <KidTabBar :current="2" />
  </view>
</template>

<script setup lang="uts">
  import { ref, computed } from 'vue'
  import KidTabBar from '@/components/KidTabBar/KidTabBar.uvue'
  import { state } from '@/store/index.uts'
  import { postRemoveWork } from '@/store/gallery.uts'
  import type { GalleryWork } from '@/types/gallery.uts'

  const statusBarHeight = ref(0)
  const previewWork = ref<GalleryWork | null>(null)

  const works = computed(() => state.gallery.works)
  const workCount = computed(() => state.gallery.works.length)

  function formatDate(ts: number): string {
    const d = new Date(ts)
    const m = d.getMonth() + 1
    const day = d.getDate()
    return m.toString() + '月' + day.toString() + '日'
  }

  function onPreview(work: GalleryWork): void {
    previewWork.value = work
  }

  function closePreview(): void {
    previewWork.value = null
  }

  function onDelete(work: GalleryWork): void {
    uni.showModal({
      title: '删除作品',
      content: '确定删除这幅作品吗？',
      success: (res) => {
        if (res.confirm) {
          postRemoveWork(work.id)
          uni.showToast({ title: '已删除', icon: 'none' })
        }
      }
    })
  }

  function goStudio(): void {
    uni.redirectTo({ url: '/pages/studio/index' })
  }

  onLoad(() => {
    const info = uni.getWindowInfo()
    statusBarHeight.value = info.statusBarHeight
  })
</script>

<style lang="scss">
  .gallery-header {
    padding: 12px 16px;
    background-color: #FFD166;
    border-bottom-width: 3px;
    border-bottom-color: #2D3436;
    border-bottom-style: solid;
  }

  .header-title {
    font-size: 20px;
    font-weight: bold;
    color: #2D3436;
  }

  .work-count {
    font-size: 14px;
    color: #636E72;
    margin-top: 4px;
  }

  .gallery-scroll { flex: 1; }

  .gallery-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px;
    justify-content: space-between;
  }

  .work-card {
    width: 46%;
    background-color: #FFFFFF;
    border-radius: 12px;
    border-width: 2px;
    border-color: #2D3436;
    border-style: solid;
    margin-bottom: 12px;
    overflow: hidden;
  }

  .work-thumb {
    width: 100%;
    height: 140px;
    background-color: #F0F0F0;
  }

  .work-title {
    font-size: 13px;
    font-weight: bold;
    color: #2D3436;
    padding: 6px 8px 0 8px;
  }

  .work-date {
    font-size: 11px;
    color: #636E72;
    padding: 2px 8px 8px 8px;
  }

  .empty-wrap {
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 40px;
  }

  .empty-icon { font-size: 64px; }
  .empty-text { font-size: 18px; font-weight: bold; color: #2D3436; margin-top: 12px; }
  .empty-hint { font-size: 14px; color: #636E72; margin-top: 8px; }

  .empty-btn {
    background-color: #7AE582;
    border-radius: 20px;
    padding: 12px 24px;
    margin-top: 20px;
    border-width: 2px;
    border-color: #2D3436;
    border-style: solid;
  }

  .empty-btn-text {
    font-size: 16px;
    font-weight: bold;
    color: #2D3436;
  }

  .preview-mask {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    align-items: center;
    justify-content: center;
    z-index: 999;
  }

  .preview-card {
    width: 300px;
    background-color: #FFFFFF;
    border-radius: 16px;
    padding: 16px;
    align-items: center;
  }

  .preview-image {
    width: 260px;
    height: 260px;
    border-radius: 8px;
  }

  .preview-title {
    font-size: 16px;
    font-weight: bold;
    color: #2D3436;
    margin-top: 12px;
  }

  .preview-close {
    background-color: #FFD166;
    border-radius: 16px;
    padding: 8px 24px;
    margin-top: 12px;
  }

  .preview-close-text {
    font-size: 14px;
    color: #2D3436;
  }
</style>
