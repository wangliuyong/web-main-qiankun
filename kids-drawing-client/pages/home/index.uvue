    font-size: 14px;
    color: #636E72;
    margin-bottom: 4px;
  }

  .card-title {
    font-size: 22px;
    font-weight: bold;
    color: #2D3436;
  }

  .card-desc {
    font-size: 14px;
    color: #636E72;
    margin-top: 4px;
  }

  .quick-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0 12px;
    justify-content: space-between;
  }

  .quick-item {
    width: 46%;
    background-color: #FFFFFF;
    border-radius: 16px;
    border-width: 3px;
    border-color: #2D3436;
    border-style: solid;
    padding: 16px;
    align-items: center;
    margin-bottom: 12px;
  }

  .quick-icon {
    font-size: 32px;
  }

  .quick-label {
    font-size: 14px;
    font-weight: bold;
    color: #2D3436;
    margin-top: 6px;
  }

  .chapter-preview {
    flex-direction: row;
    align-items: center;
    background-color: #FFFFFF;
    border-radius: 12px;
    border-width: 2px;
    border-color: #2D3436;
    border-style: solid;
    padding: 12px 16px;
    margin: 6px 16px;
  }

  .chapter-icon {
