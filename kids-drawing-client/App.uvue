<script lang="uts">
  import { loadProgress, loadGallery, loadProfile } from '@/utils/storage.uts'
  import { hydrateProgress } from '@/store/progress.uts'
  import { hydrateGallery } from '@/store/gallery.uts'
  import { setProfile, setHydrated } from '@/store/index.uts'

  export default {
    onLaunch() {
      // 从本地存储水合全局状态
      hydrateProgress(loadProgress())
      hydrateGallery(loadGallery())
      setProfile(loadProfile())
      setHydrated(true)
      console.log('小画家启蒙 App Launch')
    },
    onShow() {
      console.log('小画家启蒙 App Show')
    },
    onHide() {
      console.log('小画家启蒙 App Hide')
    }
  }
</script>

