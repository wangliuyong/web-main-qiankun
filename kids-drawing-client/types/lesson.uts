/**
 * 课程相关类型定义
 */

/** 单步引导 */
export type LessonStep = {
  /** 步骤序号 */
  order: number
  /** 提示文案 */
  hint: string
  /** 参考图形类型：line/circle/rect/triangle/star/house/sun/free */
  shapeType: string
  /** 是否必须跟画 */
  required: boolean
}

/** 单个课时 */
export type LessonItem = {
  id: string
  chapterId: string
  title: string
  description: string
  /** 难度 1-3 */
  difficulty: number
  /** 完成可得星星上限 */
  rewardStars: number
  /** 最低笔画数（完成判定） */
  minStrokes: number
  steps: LessonStep[]
  /** 解锁依赖的上一课时 id，空表示首课 */
  prevLessonId: string
}

/** 章节 */
export type ChapterItem = {
  id: string
  title: string
  description: string
  icon: string
  color: string
  lessons: LessonItem[]
}

/** 徽章定义 */
export type BadgeDef = {
  id: string
  title: string
  description: string
  /** 解锁条件：完成某章节全部课时 */
  chapterId: string
}

/** 课程根数据 */
export type LessonsData = {
  chapters: ChapterItem[]
  badges: BadgeDef[]
}
