/**
 * 进度 API — 首期读本地，预留云同步
 */
import { state } from '@/store/index.uts'
import type { ProgressData } from '@/types/progress.uts'
import { loadProgress, saveProgress } from '@/utils/storage.uts'
import { API_ENABLED, request } from '@/api/client.uts'

/** 查询学习进度 */
export function queryProgress(): Promise<ProgressData> {
  if (!API_ENABLED) {
    return new Promise<ProgressData>((resolve) => {
      const local = loadProgress()
      resolve(local)
    })
  }
  return request<ProgressData>('/progress', 'GET', null)
}

/** 同步进度到云端 */
export function postSyncProgress(payload: ProgressData): Promise<void> {
  if (!API_ENABLED) {
    return new Promise<void>((resolve) => {
      saveProgress(payload)
      resolve()
    })
  }
  const data = JSON.parse(JSON.stringify(payload)) as UTSJSONObject
  return request<void>('/progress/sync', 'POST', data)
}

/** 获取当前内存中的进度（页面直读） */
export function queryCurrentProgress(): ProgressData {
  return state.progress
}
